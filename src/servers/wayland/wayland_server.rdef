resource app_signature "application/x-vnd.Haiku-WaylandServer";

resource app_flags B_EXCLUSIVE_LAUNCH | B_BACKGROUND_APP;

resource app_version {
	major  = 1,
	middle = 0,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "Wayland server",
	long_info = "Shows the windows of Wayland programs, such as Linux programs running in containers."
};
