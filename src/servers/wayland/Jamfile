SubDir HAIKU_TOP src servers wayland ;

UsePrivateHeaders app interface shared system wayland ;
UsePrivateSystemHeaders ;
UseHeaders [ FDirName $(SUBDIR) libwayland haiku ] : true ;
UseHeaders [ FDirName $(SUBDIR) libwayland ] : true ;
UseHeaders [ FDirName $(SUBDIR) protocols ] : true ;
UseHeaders [ FDirName $(SUBDIR) util ] : true ;
UseHeaders $(SUBDIR) : true ;

SubDirCcFlags -D_DEFAULT_SOURCE -Wno-unused-parameter -Wno-error ;
SubDirC++Flags -std=gnu++20 -Wno-error -Wno-unused-parameter -Wno-unused-variable
	-fvisibility=hidden ;

SEARCH_SOURCE += [ FDirName $(SUBDIR) libwayland ] ;
SEARCH_SOURCE += [ FDirName $(SUBDIR) libwayland haiku ] ;
SEARCH_SOURCE += [ FDirName $(SUBDIR) protocols ] ;

StaticLibrary libwayland_server_haiku.a :
	connection.c
	epoll.c
	event-loop.c
	wayland-os.c
	wayland-protocol.c
	wayland-server.c
	wayland-util.c
	;

